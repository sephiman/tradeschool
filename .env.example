# Externally-managed Postgres on a shared Docker network. The backend joins this network and
# resolves Postgres by DNS alias = DB_HOST. Name it to match your ecosystem's shared network.
SHARED_NETWORK_NAME=data

# Host port + interface published for the frontend. External nginx / Cloudflare terminate TLS
# in front of this. Keep the bind on 127.0.0.1 (loopback only) unless you know you need wider.
FRONTEND_PORT=8092
FRONTEND_BIND_ADDR=127.0.0.1

# Database — the operator must create this DB and user in Postgres before first run,
# with permissions restricted to its own database (one DB + one user per app).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tradeschool
DB_USERNAME=tradeschool
DB_PASSWORD=change-me

# Session cookie (fastapi-users cookie transport + database strategy; opaque, revocable).
# Set COOKIE_SECURE=false ONLY for local plain-HTTP development.
COOKIE_SECURE=true
SESSION_COOKIE_NAME=tradeschool_session
SESSION_MAX_AGE=2592000

# Rate limiting (slowapi) on the auth endpoints.
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute

# Product defaults.
DEFAULT_LOCALE=en

# Operational toggles. DEV_MODE exposes /api/docs and the dev chart-gallery endpoints —
# keep it false in production.
DEV_MODE=false
RUN_MIGRATIONS_ON_STARTUP=true
SYNC_CONTENT_ON_STARTUP=true
